# Copiar como scripts/supabase.env y completar con los datos del proyecto
# de Supabase SOLO para re-exportar los datos. No commitear el archivo real.
#
# Importante: usar el puerto 5432 (session pooler). El 6543 es el
# transaction pooler y no sirve para pg_dump.
SUPABASE_HOST=aws-1-REGION.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres.TU_PROJECT_REF
SUPABASE_PASSWORD=TU_PASSWORD
